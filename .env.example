# ── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001

# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trainer_ai?schema=public

# ── Redis / Queue ─────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────
# RS256 key pair, PEM format, base64-encoded (openssl genrsa / openssl rsa -pubout)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Encryption (Graph refresh token at rest) ─────────
# 32-byte key, base64-encoded, for AES-256-GCM
ENCRYPTION_KEY=

# ── Microsoft Graph / Entra ID ────────────────────────
GRAPH_PROVIDER=fake
# real values only needed when GRAPH_PROVIDER=real
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=common
GRAPH_REDIRECT_URI=http://localhost:3000/api/v1/auth/microsoft/callback
# Shared secret echoed back on every Graph change notification (IV-03) — set on subscription creation, validated on receipt.
GRAPH_WEBHOOK_CLIENT_STATE=dev-webhook-client-state

# ── AI Service (other team) ───────────────────────────
AI_SERVICE_PROVIDER=fake
AI_SERVICE_BASE_URL=
AI_SERVICE_TOKEN=

# ── Storage ────────────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./.storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=media

# ── Malware scan ───────────────────────────────────────
SCANNER_PROVIDER=fake
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ── Embeddings / OCR (ours) ────────────────────────────
EMBEDDING_PROVIDER=fake
OCR_PROVIDER=fake
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=

# ── Email ──────────────────────────────────────────────
EMAIL_PROVIDER=fake
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@modrb.app

# ── Rate limiting ───────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Error tracking ───────────────────────────────────────
ERROR_TRACKING_PROVIDER=fake
# only needed when ERROR_TRACKING_PROVIDER=sentry
SENTRY_DSN=

# ── Admin dashboard (BullMQ queue UI, /admin/queues) ─────
# HTTP Basic Auth — set a real password before exposing this outside localhost
ADMIN_DASHBOARD_USER=admin
ADMIN_DASHBOARD_PASSWORD=
