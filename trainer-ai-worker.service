[Unit]
Description=Trainer AI Backend - Queue Worker
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/Trainer-Ai-Backend
ExecStart=/usr/bin/node dist/queue/worker.js
Restart=always
RestartSec=5
EnvironmentFile=/home/ubuntu/projects/Trainer-Ai-Backend/.env

[Install]
WantedBy=multi-user.target
