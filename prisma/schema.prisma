// Full data model — ARCHITECTURE.md §5. All 20 BRD entities + operational tables.
// ContentChunk.embedding is Unsupported("vector(1536)") — pgvector has no native Prisma type;
// the column, extension and HNSW index are created by the raw-SQL migration (P1-2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────
// Enums (§5.1)
// ─────────────────────────────────────────────────────────────────────────

enum PortalRole {
  DEPARTMENT_MANAGER
  CONTENT_CREATOR
  ADMIN
}

enum ContentType {
  DOCUMENT
  SLIDES
  TEXT
  LINK
  IMAGE
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Language {
  EN
  AR
}

enum TrainingForm {
  CONVERSATION
  CASE
  SIMULATION
  ROLEPLAY
}

enum OutcomeStatus {
  NOT_STARTED
  IN_PROGRESS
  ACHIEVED
  NOT_ACHIEVED
}

enum SessionStatus {
  SCHEDULED
  INVITED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SessionVerdict {
  ACHIEVED
  PARTIALLY_ACHIEVED
  NOT_ACHIEVED
}

enum RsvpStatus {
  PENDING
  ACCEPTED
  DECLINED
  TENTATIVE
}

enum RecommendationStatus {
  PROPOSED
  CONFIRMED
  OVERRIDDEN
  REJECTED
}

enum RecommendationTrigger {
  LEVEL_ASSIGNED
  PLAN_BUILD
  SESSION_ENDED
  OUTCOME_FAILED
  LEVEL_CHANGED
  MANUAL
}

enum PlanStatus {
  DRAFT
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MediaScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

enum ReportStatus {
  PENDING
  GENERATED
  SENT
  FAILED
}

enum ReportType {
  SESSION
  PLAN_SUMMARY
}

enum LearnerStatus {
  ACTIVE
  INACTIVE
  REMOVED
  PENDING_INVITE
}

enum SessionContentSource {
  RECOMMENDED
  MANUAL
  IN_SESSION_REMEDIAL
}

enum AuditActorType {
  USER
  SYSTEM
  AGENT
}

enum PortalInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// ─────────────────────────────────────────────────────────────────────────
// Tenancy root
// ─────────────────────────────────────────────────────────────────────────

model Organization {
  id                      String   @id @default(cuid(2))
  entraTenantId           String?  @unique
  name                    String
  defaultLanguage         Language @default(EN)
  logoUrl                 String?
  reportBranding          Json?
  transcriptRetentionDays Int      @default(90)
  auditRetentionDays      Int      @default(730)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  portalUsers      PortalUser[]
  departments      Department[]
  teams            Team[]
  learners         Learner[]
  tracks           Track[]
  skills           Skill[]
  contentItems     ContentItem[]
  recommendations  Recommendation[]
  trainingPlans    TrainingPlan[]
  planTemplates    PlanTemplate[]
  sessions         Session[]
  reports          Report[]
  auditLogs        AuditLog[]
  portalInvites    PortalInvite[]
  slideDecks       SlideDeck[]
  externalSessions ExternalSession[]

  @@map("organizations")
}

/// First-class department, replacing the free-text `department` strings
/// previously duplicated independently on `Track`/`Learner` with no shared
/// lookup or FK relationship between them. A `Team`'s `departmentId` is the
/// actual scoping unit behind PRD's "Department Manager" role — one manager
/// per team, one team per department (`WS-02`, `NV-04`, `PA-06`).
model Department {
  id             String   @id @default(cuid(2))
  organizationId String
  name           String
  isEnabled      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  teams        Team[]
  tracks       Track[]
  learners     Learner[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("departments")
}

// ─────────────────────────────────────────────────────────────────────────
// Auth & Users
// ─────────────────────────────────────────────────────────────────────────

model PortalUser {
  id                       String     @id @default(cuid(2))
  organizationId           String
  entraObjectId            String?    @unique
  email                    String
  passwordHash             String?
  name                     String
  role                     PortalRole
  locale                   Language   @default(EN)
  isActive                 Boolean    @default(true)
  lastLoginAt              DateTime?
  graphTokenCacheEncrypted String?
  graphHomeAccountId       String?
  failedLoginCount         Int        @default(0)
  lockedUntil              DateTime?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  organization             Organization        @relation(fields: [organizationId], references: [id])
  refreshTokens            RefreshToken[]
  managedTeams             Team[]              @relation("TeamManager")
  experienceLogs           LearnerExperience[] @relation("ExperienceRecordedBy")
  assignments              LearnerAssignment[] @relation("AssignmentAssignedBy")
  contentCreated           ContentItem[]       @relation("ContentCreatedBy")
  recommendationsConfirmed Recommendation[]    @relation("RecommendationConfirmedBy")
  plansCreated             TrainingPlan[]      @relation("PlanCreatedBy")
  planTemplatesCreated     PlanTemplate[]      @relation("PlanTemplateCreatedBy")
  invitesSent              PortalInvite[]      @relation("InviteInvitedBy")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("portal_users")
}

/// Onboarding invite for MANAGER/CONTENT_MANAGER — distinct from `Invitation`
/// (session-meeting RSVP tracking, §6.9) which happens to share a plain-
/// English name but is a completely different concept. Acceptance is folded
/// into `POST /auth/microsoft/callback` (see AuthService.signInWithMicrosoft)
/// rather than a separate accept endpoint — the invited user's own MS login
/// IS their account-creation step, keyed by matching `email` against the
/// MS claims on that callback.
model PortalInvite {
  id             String             @id @default(cuid(2))
  organizationId String
  email          String
  role           PortalRole
  invitedById    String
  status         PortalInviteStatus @default(PENDING)
  token          String             @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedUserId String?
  createdAt      DateTime           @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id])
  invitedBy        PortalUser   @relation("InviteInvitedBy", fields: [invitedById], references: [id])
  pendingManagerOf Team?        @relation("TeamPendingManager")

  @@index([organizationId])
  @@index([email])
  @@map("portal_invites")
}

model RefreshToken {
  id           String    @id @default(cuid(2))
  userId       String
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @unique
  createdAt    DateTime  @default(now())

  user        PortalUser    @relation(fields: [userId], references: [id])
  replacedBy  RefreshToken? @relation("TokenReplacement", fields: [replacedById], references: [id])
  replacedFor RefreshToken? @relation("TokenReplacement")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Server-side PKCE code_verifier storage between `/auth/microsoft/start` and
/// `/auth/microsoft/callback` — the two legs of Entra's auth-code flow run as
/// separate requests, so the verifier can't just live in a closure. Keyed by
/// `state` (also CSRF-mitigating per MSAL's own `validateState`). Expired
/// rows are swept by the nightly `cleanup` job.
model PkceEntry {
  state        String   @id
  codeVerifier String
  /// Round-trips a `PortalInvite.token` through the two-request Entra
  /// auth-code flow, same way `state`/`codeVerifier` already do — set at
  /// `/auth/microsoft/start` when the login originated from an invite link,
  /// consumed at `/auth/microsoft/callback` by `AuthService.signInWithMicrosoft`.
  inviteToken  String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
  @@map("pkce_entries")
}

// ─────────────────────────────────────────────────────────────────────────
// Teams & Learners
// ─────────────────────────────────────────────────────────────────────────

model Team {
  id                     String   @id @default(cuid(2))
  organizationId         String
  departmentId           String
  managerId              String?
  /// Set when the team is created (or edited) with a manager who was just
  /// invited rather than an existing `PortalUser` — `managerId` stays null
  /// until `AuthService.signInWithMicrosoft` resolves the invite on accept,
  /// at which point it fills in `managerId` and clears this field.
  pendingManagerInviteId String?  @unique
  name                   String
  description            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization         Organization  @relation(fields: [organizationId], references: [id])
  department           Department    @relation(fields: [departmentId], references: [id])
  manager              PortalUser?   @relation("TeamManager", fields: [managerId], references: [id])
  pendingManagerInvite PortalInvite? @relation("TeamPendingManager", fields: [pendingManagerInviteId], references: [id])
  learners             Learner[]

  @@index([organizationId])
  @@index([departmentId])
  @@index([managerId])
  @@map("teams")
}

model Learner {
  id                String        @id @default(cuid(2))
  organizationId    String
  teamId            String
  departmentId      String?
  entraObjectId     String
  email             String
  displayName       String
  jobTitle          String?
  preferredLanguage Language      @default(EN)
  status            LearnerStatus @default(ACTIVE)
  deactivatedAt     DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization     Organization        @relation(fields: [organizationId], references: [id])
  team             Team                @relation(fields: [teamId], references: [id])
  department       Department?         @relation(fields: [departmentId], references: [id])
  experience       LearnerExperience?
  assignments      LearnerAssignment[]
  outcomes         LearnerOutcome[]
  recommendations  Recommendation[]
  trainingPlans    TrainingPlan[]
  sessions         Session[]
  invitations      Invitation[]
  externalSessions ExternalSession[]

  @@unique([organizationId, entraObjectId])
  @@index([organizationId])
  @@index([teamId])
  @@index([departmentId])
  @@map("learners")
}

model LearnerExperience {
  id                String   @id @default(cuid(2))
  learnerId         String   @unique
  background        String
  yearsOfExperience Int
  priorTraining     String?
  notes             String?
  recordedById      String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  learner    Learner    @relation(fields: [learnerId], references: [id])
  recordedBy PortalUser @relation("ExperienceRecordedBy", fields: [recordedById], references: [id])

  @@map("learner_experiences")
}

// ─────────────────────────────────────────────────────────────────────────
// Catalogue: Tracks, Levels, Outcomes
// ─────────────────────────────────────────────────────────────────────────

model Track {
  id               String       @id @default(cuid(2))
  organizationId   String
  departmentId     String
  key              String
  nameEn           String
  nameAr           String
  descriptionEn    String
  descriptionAr    String
  targetSkills     String[]
  trainingForm     TrainingForm
  impactIndicators String[]
  isEnabled        Boolean      @default(true)
  sortOrder        Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id])
  department    Department     @relation(fields: [departmentId], references: [id])
  levels        Level[]
  contentItems  ContentItem[]
  planTemplates PlanTemplate[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([departmentId])
  @@map("tracks")
}

model Skill {
  id                String   @id @default(cuid(2))
  organizationId    String
  /// Skill ownership moved from Track-level (the old `TrackSkill` join
  /// table, now dropped) to Level-level, matching PRD v1.0's
  /// Track→Level→Skill→Outcome hierarchy. Nullable through the migration
  /// window for skills the backfill couldn't confidently resolve to a
  /// single level — same nullable-then-manual-resolution pattern
  /// `Outcome.skillId` already uses.
  levelId           String?
  key               String
  nameEn            String
  nameAr            String
  descriptionEn     String
  descriptionAr     String
  /// Proficiency levels this skill applies at (Beginner/Intermediate/
  /// Advanced/Expert) — a multi-select label set, unrelated to `levelId`
  /// (which is the single `Level` row that owns this skill).
  levels            String[]
  assessmentEnabled Boolean  @default(true)
  isEnabled         Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  level        Level?       @relation(fields: [levelId], references: [id])
  outcomes     Outcome[]
  slideDecks   SlideDeck[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([levelId])
  @@map("skills")
}

model Level {
  id            String   @id @default(cuid(2))
  trackId       String
  key           String
  nameEn        String
  nameAr        String
  descriptionEn String
  descriptionAr String
  order         Int
  isEnabled     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  track         Track               @relation(fields: [trackId], references: [id])
  skills        Skill[]
  outcomes      Outcome[]
  contentItems  ContentItem[]
  assignments   LearnerAssignment[]
  planTemplates PlanTemplate[]

  @@unique([trackId, order])
  @@unique([trackId, key])
  @@index([trackId])
  @@map("levels")
}

model Outcome {
  id           String   @id @default(cuid(2))
  levelId      String
  /// New 1:1 owner — an Outcome has exactly one Skill. Nullable through the
  /// migration window: existing rows are backfilled from `targetSkills[0]`
  /// by the skill-relations migration script; rows the script can't
  /// confidently resolve (0 or >1 entries in `targetSkills`) stay null for
  /// manual admin resolution and are surfaced in that script's report.
  /// Tighten to required once the report is clear (see BUILD_PLAN).
  skillId      String?
  titleEn      String
  titleAr      String
  /// @deprecated superseded by `skillId` — kept through the migration window.
  targetSkills String[]
  order        Int
  isEnabled    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  level                Level                  @relation(fields: [levelId], references: [id])
  skill                Skill?                 @relation(fields: [skillId], references: [id])
  contentOutcomes      ContentOutcome[]
  prerequisiteFor      ContentPrerequisite[]  @relation("PrerequisiteOutcome")
  learnerOutcomes      LearnerOutcome[]
  questionBanks        QuestionBank[]
  rubrics              Rubric[]
  recommendationItems  RecommendationItem[]
  sessionOutcomes      SessionOutcome[]
  contentEffectiveness ContentEffectiveness[]
  sessions             Session[]

  @@unique([levelId, order])
  @@index([levelId])
  @@index([skillId])
  @@map("outcomes")
}

// ─────────────────────────────────────────────────────────────────────────
// AI Trainer integration — SlideDeck / ExternalSession
// ─────────────────────────────────────────────────────────────────────────

/// One generated slide deck per `Skill`, produced by the external AI Trainer
/// service's `POST /slides` (one deck per skill in a track). `aiDeckId` is
/// their `slide_deck_id` (uuid) — the FK we pass back to them on
/// `POST /sessions/external`. Re-generating a skill's deck updates this row
/// in place (upsert on `skillId`) rather than creating a duplicate.
model SlideDeck {
  id              String   @id @default(cuid(2))
  organizationId  String
  skillId         String
  aiDeckId        String   @unique
  status          String
  slideCount      Int?
  generationError String?
  downloadUrl     String?
  createdAt       DateTime @default(now())

  organization     Organization      @relation(fields: [organizationId], references: [id])
  skill            Skill             @relation(fields: [skillId], references: [id])
  externalSessions ExternalSession[]

  @@index([skillId])
  @@map("slide_decks")
}

/// A live AI-trainer-bot session on an already-provisioned meeting link,
/// started via the external AI Trainer service's `POST /sessions/external`.
/// `id` is THEIR session id (uuid), used as our PK directly rather than
/// minting our own — this row is a thin local record of ownership +
/// opportunistically-cached progress; transcript/evaluation are never
/// persisted here and are always proxied live (see `ai-trainer` module).
model ExternalSession {
  id                   String    @id
  organizationId       String
  learnerId            String
  slideDeckId          String
  skillName            String
  userRole             String
  meetingUrl           String
  status               String
  dispatchError        String?
  currentSlideIndex    Int?
  maxSlideIndexReached Int?
  questionsRecorded    Int?
  startedAt            DateTime?
  endedAt              DateTime?
  createdAt            DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  learner      Learner      @relation(fields: [learnerId], references: [id])
  slideDeck    SlideDeck    @relation(fields: [slideDeckId], references: [id])

  @@index([learnerId])
  @@index([slideDeckId])
  @@map("external_sessions")
}

// ─────────────────────────────────────────────────────────────────────────
// Learner assignment & outcome tracking
// ─────────────────────────────────────────────────────────────────────────

model LearnerAssignment {
  id           String    @id @default(cuid(2))
  learnerId    String
  trackId      String
  levelId      String
  assignedById String
  assignedAt   DateTime  @default(now())
  completedAt  DateTime?
  isActive     Boolean   @default(true)

  learner         Learner          @relation(fields: [learnerId], references: [id])
  level           Level            @relation(fields: [levelId], references: [id])
  assignedBy      PortalUser       @relation("AssignmentAssignedBy", fields: [assignedById], references: [id])
  learnerOutcomes LearnerOutcome[]
  recommendations Recommendation[]
  trainingPlans   TrainingPlan[]

  @@index([learnerId])
  @@index([levelId])
  @@map("learner_assignments")
}

model LearnerOutcome {
  id           String        @id @default(cuid(2))
  learnerId    String
  outcomeId    String
  assignmentId String
  status       OutcomeStatus @default(NOT_STARTED)
  priority     Int           @default(0)
  isCustom     Boolean       @default(false)
  attemptCount Int           @default(0)
  lastScore    Int?
  achievedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  learner    Learner           @relation(fields: [learnerId], references: [id])
  outcome    Outcome           @relation(fields: [outcomeId], references: [id])
  assignment LearnerAssignment @relation(fields: [assignmentId], references: [id])

  @@unique([learnerId, outcomeId, assignmentId])
  @@index([learnerId, status])
  @@map("learner_outcomes")
}

// ─────────────────────────────────────────────────────────────────────────
// Content
// ─────────────────────────────────────────────────────────────────────────

model ContentItem {
  id              String        @id @default(cuid(2))
  organizationId  String
  title           String
  trackId         String
  levelId         String
  contentType     ContentType
  textBody        String?
  sourceUrl       String?
  language        Language
  status          ContentStatus @default(DRAFT)
  version         Int           @default(1)
  parentVersionId String?       @unique
  skillTags       String[]
  createdById     String
  publishedAt     DateTime?
  archivedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id])
  track         Track        @relation(fields: [trackId], references: [id])
  level         Level        @relation(fields: [levelId], references: [id])
  createdBy     PortalUser   @relation("ContentCreatedBy", fields: [createdById], references: [id])
  parentVersion ContentItem? @relation("ContentVersioning", fields: [parentVersionId], references: [id])
  childVersion  ContentItem? @relation("ContentVersioning")

  contentOutcomes     ContentOutcome[]
  prerequisites       ContentPrerequisite[]  @relation("ContentPrerequisiteOf")
  requiredBy          ContentPrerequisite[]  @relation("PrerequisiteContent")
  mediaAssets         MediaAsset[]
  contentChunks       ContentChunk[]
  recommendationItems RecommendationItem[]
  effectiveness       ContentEffectiveness[]
  sessionContents     SessionContent[]

  @@index([organizationId, status, trackId, levelId, language])
  @@map("content_items")
}

model ContentOutcome {
  contentItemId String
  outcomeId     String

  contentItem ContentItem @relation(fields: [contentItemId], references: [id])
  outcome     Outcome     @relation(fields: [outcomeId], references: [id])

  @@id([contentItemId, outcomeId])
  @@index([outcomeId])
  @@map("content_outcomes")
}

model ContentPrerequisite {
  id                    String   @id @default(cuid(2))
  contentItemId         String
  prerequisiteContentId String?
  prerequisiteOutcomeId String?
  createdAt             DateTime @default(now())

  contentItem         ContentItem  @relation("ContentPrerequisiteOf", fields: [contentItemId], references: [id])
  prerequisiteContent ContentItem? @relation("PrerequisiteContent", fields: [prerequisiteContentId], references: [id])
  prerequisiteOutcome Outcome?     @relation("PrerequisiteOutcome", fields: [prerequisiteOutcomeId], references: [id])

  @@index([contentItemId])
  @@map("content_prerequisites")
}

model MediaAsset {
  id               String          @id @default(cuid(2))
  contentItemId    String
  blobKey          String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  checksum         String
  caption          String?
  altTextEn        String?
  altTextAr        String?
  extractedText    String?
  pageCount        Int?
  scanStatus       MediaScanStatus @default(PENDING)
  processedAt      DateTime?
  createdAt        DateTime        @default(now())

  contentItem   ContentItem    @relation(fields: [contentItemId], references: [id])
  contentChunks ContentChunk[]

  @@index([contentItemId])
  @@map("media_assets")
}

/// ContentChunk.embedding is added, typed vector(1536) and HNSW-indexed by the
/// raw-SQL migration in P1-2 — Prisma has no native pgvector type (see ARCHITECTURE §5.2).
model ContentChunk {
  id            String                       @id @default(cuid(2))
  contentItemId String
  mediaAssetId  String?
  chunkIndex    Int
  text          String
  tokenCount    Int
  embedding     Unsupported("vector(1536)")?
  createdAt     DateTime                     @default(now())

  contentItem ContentItem @relation(fields: [contentItemId], references: [id])
  mediaAsset  MediaAsset? @relation(fields: [mediaAssetId], references: [id])

  @@index([contentItemId])
  @@map("content_chunks")
}

// ─────────────────────────────────────────────────────────────────────────
// Question banks & rubrics
// ─────────────────────────────────────────────────────────────────────────

model QuestionBank {
  id        String   @id @default(cuid(2))
  outcomeId String
  language  Language
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  outcome   Outcome    @relation(fields: [outcomeId], references: [id])
  questions Question[]

  @@unique([outcomeId, language])
  @@index([outcomeId])
  @@map("question_banks")
}

model Question {
  id             String     @id @default(cuid(2))
  questionBankId String
  prompt         String
  difficulty     Difficulty
  expectedAnswer String?
  modelAnswer    String?
  order          Int

  questionBank QuestionBank       @relation(fields: [questionBankId], references: [id])
  answers      AssessmentAnswer[]

  @@index([questionBankId])
  @@map("questions")
}

model Rubric {
  id            String   @id @default(cuid(2))
  outcomeId     String
  name          String
  passThreshold Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  outcome     Outcome           @relation(fields: [outcomeId], references: [id])
  criteria    RubricCriterion[]
  assessments Assessment[]

  @@index([outcomeId])
  @@map("rubrics")
}

model RubricCriterion {
  id          String @id @default(cuid(2))
  rubricId    String
  label       String
  description String
  weight      Int
  order       Int

  rubric Rubric @relation(fields: [rubricId], references: [id])

  @@index([rubricId])
  @@map("rubric_criteria")
}

// ─────────────────────────────────────────────────────────────────────────
// Recommendation engine
// ─────────────────────────────────────────────────────────────────────────

model Recommendation {
  id             String                @id @default(cuid(2))
  organizationId String
  learnerId      String
  sessionId      String?
  assignmentId   String
  trigger        RecommendationTrigger
  status         RecommendationStatus  @default(PROPOSED)
  generatedAt    DateTime              @default(now())
  confirmedAt    DateTime?
  confirmedById  String?

  organization Organization         @relation(fields: [organizationId], references: [id])
  learner      Learner              @relation(fields: [learnerId], references: [id])
  session      Session?             @relation(fields: [sessionId], references: [id])
  assignment   LearnerAssignment    @relation(fields: [assignmentId], references: [id])
  confirmedBy  PortalUser?          @relation("RecommendationConfirmedBy", fields: [confirmedById], references: [id])
  items        RecommendationItem[]

  @@index([organizationId])
  @@index([learnerId])
  @@map("recommendations")
}

model RecommendationItem {
  id               String               @id @default(cuid(2))
  recommendationId String
  contentItemId    String
  outcomeId        String
  rank             Int
  score            Float
  reasonCode       String
  reasonEn         String
  reasonAr         String
  signalBreakdown  Json
  status           RecommendationStatus @default(PROPOSED)
  overriddenWithId String?              @unique

  recommendation Recommendation      @relation(fields: [recommendationId], references: [id])
  contentItem    ContentItem         @relation(fields: [contentItemId], references: [id])
  outcome        Outcome             @relation(fields: [outcomeId], references: [id])
  overriddenWith RecommendationItem? @relation("ItemOverride", fields: [overriddenWithId], references: [id])
  overriddenBy   RecommendationItem? @relation("ItemOverride")

  @@index([recommendationId])
  @@map("recommendation_items")
}

model ContentEffectiveness {
  id                 String   @id @default(cuid(2))
  contentItemId      String
  outcomeId          String
  timesDelivered     Int      @default(0)
  timesAchieved      Int      @default(0)
  effectivenessScore Float    @default(0)
  lastComputedAt     DateTime @default(now())

  contentItem ContentItem @relation(fields: [contentItemId], references: [id])
  outcome     Outcome     @relation(fields: [outcomeId], references: [id])

  @@unique([contentItemId, outcomeId])
  @@map("content_effectiveness")
}

// ─────────────────────────────────────────────────────────────────────────
// Training plans & sessions
// ─────────────────────────────────────────────────────────────────────────

model TrainingPlan {
  id             String     @id @default(cuid(2))
  organizationId String
  learnerId      String
  assignmentId   String
  title          String
  trainingDays   Int
  status         PlanStatus @default(DRAFT)
  startDate      DateTime
  endDate        DateTime
  createdById    String
  confirmedAt    DateTime?
  templateId     String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization  Organization       @relation(fields: [organizationId], references: [id])
  learner       Learner            @relation(fields: [learnerId], references: [id])
  assignment    LearnerAssignment  @relation(fields: [assignmentId], references: [id])
  createdBy     PortalUser         @relation("PlanCreatedBy", fields: [createdById], references: [id])
  template      PlanTemplate?      @relation(fields: [templateId], references: [id])
  sessions      Session[]
  reports       Report[]
  trackSnapshot PlanTrackSnapshot?

  @@index([organizationId])
  @@index([learnerId])
  @@map("training_plans")
}

// ─────────────────────────────────────────────────────────────────────────
// Plan-scoped catalogue snapshot — a manager tweaking one plan's skills/
// outcomes/content (add/edit/remove) never mutates the shared master
// Track/Skill/Outcome/ContentItem catalogue. `sourceXId` is provenance only
// (nullable — a manager-authored addition has no master counterpart), never
// a live dependency for rendering the plan. Recommendation-engine picks for
// a snapshot-based plan are NOT persisted to `Recommendation`/
// `RecommendationItem` (those FK to master Content/Outcome) — see
// `PlanSnapshotService`/`RecommendationService`'s snapshot branch.
// ─────────────────────────────────────────────────────────────────────────

model PlanTrackSnapshot {
  id             String   @id @default(cuid(2))
  trainingPlanId String   @unique
  sourceTrackId  String
  nameEn         String
  nameAr         String
  descriptionEn  String
  descriptionAr  String
  createdAt      DateTime @default(now())

  trainingPlan TrainingPlan          @relation(fields: [trainingPlanId], references: [id])
  skills       PlanSkillSnapshot[]
  outcomes     PlanOutcomeSnapshot[]
  content      PlanContentSnapshot[]

  @@map("plan_track_snapshots")
}

model PlanSkillSnapshot {
  id            String   @id @default(cuid(2))
  snapshotId    String
  /// null = manager-added skill with no master counterpart, plan-only.
  sourceSkillId String?
  nameEn        String
  nameAr        String
  descriptionEn String   @default("")
  descriptionAr String   @default("")
  /// Copy of `Skill.levels[]` at snapshot time — global to the skill, not
  /// per-track, matching the corrected master-catalogue model.
  levels        String[]
  /// Soft-delete: manager unchecked a master-copied skill for this plan.
  isRemoved     Boolean  @default(false)
  createdAt     DateTime @default(now())

  snapshot PlanTrackSnapshot     @relation(fields: [snapshotId], references: [id])
  outcomes PlanOutcomeSnapshot[]
  content  PlanContentSnapshot[]

  @@index([snapshotId])
  @@map("plan_skill_snapshots")
}

model PlanOutcomeSnapshot {
  id              String   @id @default(cuid(2))
  snapshotId      String
  skillSnapshotId String
  sourceOutcomeId String?
  titleEn         String
  titleAr         String
  descriptionEn   String
  descriptionAr   String
  order           Int
  isRemoved       Boolean  @default(false)
  createdAt       DateTime @default(now())

  snapshot      PlanTrackSnapshot           @relation(fields: [snapshotId], references: [id])
  skillSnapshot PlanSkillSnapshot           @relation(fields: [skillSnapshotId], references: [id])
  progress      PlanLearnerOutcomeSnapshot?

  @@index([snapshotId])
  @@index([skillSnapshotId])
  @@map("plan_outcome_snapshots")
}

/// Per-snapshot-outcome progress tracking — the `LearnerOutcome` analog for
/// a plan-scoped outcome, since `LearnerOutcome` is hard-FK'd to the real
/// `Outcome` table and can't point at a `PlanOutcomeSnapshot` row. One row
/// per `PlanOutcomeSnapshot`, created alongside it (mirrors how
/// `LearnerAssignmentRepository.assignWithOutcomes` materializes one
/// `LearnerOutcome` per outcome today).
model PlanLearnerOutcomeSnapshot {
  id                String        @id @default(cuid(2))
  outcomeSnapshotId String        @unique
  status            OutcomeStatus @default(NOT_STARTED)
  attemptCount      Int           @default(0)
  lastScore         Int?
  achievedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  outcomeSnapshot PlanOutcomeSnapshot @relation(fields: [outcomeSnapshotId], references: [id])

  @@map("plan_learner_outcome_snapshots")
}

model PlanContentSnapshot {
  id              String      @id @default(cuid(2))
  snapshotId      String
  /// Owning skill within the snapshot — content is skill-scoped here (unlike
  /// the master catalogue's ContentItem, which links to outcomes via
  /// ContentOutcome), matching how the track-creation wizard collects
  /// content per skill card. Nullable only through the migration window for
  /// rows created before this column existed.
  skillSnapshotId String?
  sourceContentId String?
  title           String
  contentType     ContentType
  sourceUrl       String?
  textBody        String?
  isRemoved       Boolean     @default(false)
  createdAt       DateTime    @default(now())

  snapshot      PlanTrackSnapshot  @relation(fields: [snapshotId], references: [id])
  skillSnapshot PlanSkillSnapshot? @relation(fields: [skillSnapshotId], references: [id])
  media         PlanContentMedia[]

  @@index([snapshotId])
  @@index([skillSnapshotId])
  @@map("plan_content_snapshots")
}

/// Plan-scoped counterpart to `MediaAsset` — a DOCUMENT/SLIDES/IMAGE
/// `PlanContentSnapshot` needs an uploaded blob the same way a master
/// `ContentItem` does, but `MediaAsset.contentItemId` is a required FK, so a
/// separate table (not a nullable-widened `MediaAsset`) keeps the existing
/// master-catalogue media pipeline's invariants untouched.
model PlanContentMedia {
  id                String          @id @default(cuid(2))
  contentSnapshotId String
  blobKey           String
  originalFilename  String
  mimeType          String
  sizeBytes         Int
  checksum          String
  scanStatus        MediaScanStatus @default(PENDING)
  processedAt       DateTime?
  createdAt         DateTime        @default(now())

  contentSnapshot PlanContentSnapshot @relation(fields: [contentSnapshotId], references: [id])

  @@index([contentSnapshotId])
  @@map("plan_content_media")
}

model PlanTemplate {
  id             String   @id @default(cuid(2))
  organizationId String
  name           String
  trackId        String
  levelId        String
  structure      Json
  createdById    String
  createdAt      DateTime @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id])
  track         Track          @relation(fields: [trackId], references: [id])
  level         Level          @relation(fields: [levelId], references: [id])
  createdBy     PortalUser     @relation("PlanTemplateCreatedBy", fields: [createdById], references: [id])
  trainingPlans TrainingPlan[]

  @@index([organizationId])
  @@map("plan_templates")
}

model Session {
  id               String          @id @default(cuid(2))
  organizationId   String
  planId           String
  learnerId        String
  primaryOutcomeId String
  sequence         Int
  scheduledStart   DateTime
  scheduledEnd     DateTime
  durationMinutes  Int
  status           SessionStatus   @default(SCHEDULED)
  verdict          SessionVerdict?
  score            Int?
  graphEventId     String?
  joinUrl          String?
  joinToken        String          @unique
  startedAt        DateTime?
  endedAt          DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  plan           TrainingPlan @relation(fields: [planId], references: [id])
  learner        Learner      @relation(fields: [learnerId], references: [id])
  primaryOutcome Outcome      @relation(fields: [primaryOutcomeId], references: [id])

  sessionOutcomes SessionOutcome[]
  sessionContents SessionContent[]
  invitations     Invitation[]
  assessments     Assessment[]
  reports         Report[]
  recommendations Recommendation[]

  @@index([organizationId, scheduledStart])
  @@index([planId, sequence])
  @@index([learnerId, scheduledStart])
  @@map("sessions")
}

model SessionOutcome {
  sessionId     String
  outcomeId     String
  isCarriedOver Boolean         @default(false)
  verdict       SessionVerdict?
  score         Int?

  session Session @relation(fields: [sessionId], references: [id])
  outcome Outcome @relation(fields: [outcomeId], references: [id])

  @@id([sessionId, outcomeId])
  @@map("session_outcomes")
}

model SessionContent {
  id            String               @id @default(cuid(2))
  sessionId     String
  contentItemId String
  order         Int
  source        SessionContentSource @default(RECOMMENDED)
  deliveredAt   DateTime?

  session     Session     @relation(fields: [sessionId], references: [id])
  contentItem ContentItem @relation(fields: [contentItemId], references: [id])

  @@index([sessionId])
  @@map("session_contents")
}

model Invitation {
  id                String     @id @default(cuid(2))
  sessionId         String
  learnerId         String
  graphEventId      String
  sentAt            DateTime   @default(now())
  rsvpStatus        RsvpStatus @default(PENDING)
  respondedAt       DateTime?
  reminderSentAt    DateTime?
  joinedAt          DateTime?
  leftAt            DateTime?
  attendanceMinutes Int?

  session Session @relation(fields: [sessionId], references: [id])
  learner Learner @relation(fields: [learnerId], references: [id])

  @@index([sessionId])
  @@index([learnerId])
  @@map("invitations")
}

// ─────────────────────────────────────────────────────────────────────────
// Assessments
// ─────────────────────────────────────────────────────────────────────────

model Assessment {
  id                       String         @id @default(cuid(2))
  sessionId                String
  rubricId                 String?
  totalScore               Int
  verdict                  SessionVerdict
  strengths                String
  gaps                     String
  agentNotes               String
  transcriptUrl            String?
  transcriptRetentionUntil DateTime?
  recordingConsentAt       DateTime?
  completedAt              DateTime       @default(now())

  session Session            @relation(fields: [sessionId], references: [id])
  rubric  Rubric?            @relation(fields: [rubricId], references: [id])
  answers AssessmentAnswer[]

  @@index([sessionId])
  @@map("assessments")
}

model AssessmentAnswer {
  id              String   @id @default(cuid(2))
  assessmentId    String
  questionId      String?
  outcomeId       String
  questionText    String
  answerText      String
  score           Int
  maxScore        Int
  criterionScores Json
  feedback        String?
  answeredAt      DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id])
  question   Question?  @relation(fields: [questionId], references: [id])

  @@index([assessmentId])
  @@map("assessment_answers")
}

// ─────────────────────────────────────────────────────────────────────────
// Reports
// ─────────────────────────────────────────────────────────────────────────

model Report {
  id             String       @id @default(cuid(2))
  organizationId String
  sessionId      String?
  planId         String?
  type           ReportType
  language       Language
  blobKey        String?
  status         ReportStatus @default(PENDING)
  generatedAt    DateTime?
  recipients     Json
  sentAt         DateTime?
  failureReason  String?
  resendCount    Int          @default(0)
  createdAt      DateTime     @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id])
  session      Session?      @relation(fields: [sessionId], references: [id])
  plan         TrainingPlan? @relation(fields: [planId], references: [id])

  @@index([organizationId])
  @@index([sessionId])
  @@map("reports")
}

// ─────────────────────────────────────────────────────────────────────────
// Public website
// ─────────────────────────────────────────────────────────────────────────

model DemoRequest {
  id             String   @id @default(cuid(2))
  name           String
  email          String
  company        String
  phone          String?
  message        String?
  locale         Language @default(EN)
  consentGivenAt DateTime
  createdAt      DateTime @default(now())

  @@map("demo_requests")
}

// ─────────────────────────────────────────────────────────────────────────
// Audit
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id             String         @id @default(cuid(2))
  organizationId String
  actorId        String?
  actorType      AuditActorType
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  ip             String?
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, entityType, entityId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
